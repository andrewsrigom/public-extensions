{
  "name": "quick-notes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wxt build",
    "clean": "wxt clean",
    "dev": "wxt",
    "quality": "pnpm typecheck && pnpm test:run && pnpm build",
    "release:check": "pnpm quality && pnpm zip",
    "release:assets:check": "node scripts/check-release-assets.mjs",
    "test": "vitest",
    "test:run": "vitest run && node --test scripts/check-release-assets.test.mjs",
    "typecheck": "wxt prepare && tsc --noEmit",
    "zip": "wxt zip && pnpm release:assets:check"
  },
  "dependencies": {
    "@blocknote/core": "^0.54.0",
    "@blocknote/mantine": "^0.54.0",
    "@blocknote/react": "^0.54.0",
    "@browser-extensions/ui": "workspace:*",
    "@mantine/core": "^9.4.1",
    "@mantine/hooks": "^9.4.1",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3"
  }
}
