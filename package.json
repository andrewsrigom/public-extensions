{
  "name": "public-extensions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "pnpm watched-filter:build",
    "check:public-boundary": "node scripts/check-public-boundary.mjs --export",
    "check:public-export": "node scripts/check-public-boundary.mjs --export",
    "clean": "pnpm watched-filter:clean && pnpm product-filter:clean && pnpm quick-notes:clean && pnpm time-zone-helper:clean && pnpm site-reset:clean && pnpm pathswitch:clean",
    "dev": "pnpm watched-filter:dev",
    "export:public": "node scripts/export-public-workspace.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:check:public": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:public": "eslint .",
    "licenses:check:public": "node scripts/generate-public-license-notices.mjs --check",
    "licenses:check:release": "node scripts/check-public-release-licenses.mjs",
    "licenses:generate:public": "node scripts/generate-public-license-notices.mjs",
    "pathswitch:build": "pnpm --filter pathswitch build",
    "pathswitch:clean": "pnpm --filter pathswitch clean",
    "pathswitch:dev": "pnpm --filter pathswitch dev",
    "pathswitch:quality": "pnpm --filter pathswitch quality",
    "pathswitch:release:check": "pnpm --filter pathswitch release:check",
    "pathswitch:test": "pnpm --filter pathswitch test:run",
    "pathswitch:typecheck": "pnpm --filter pathswitch typecheck",
    "pathswitch:zip": "pnpm --filter pathswitch zip",
    "product-filter:build": "pnpm --filter product-filter build",
    "product-filter:clean": "pnpm --filter product-filter clean",
    "product-filter:dev": "pnpm --filter product-filter dev",
    "product-filter:quality": "pnpm --filter product-filter quality",
    "product-filter:release:check": "pnpm --filter product-filter release:check",
    "product-filter:test": "pnpm --filter product-filter test:run",
    "product-filter:typecheck": "pnpm --filter product-filter typecheck",
    "product-filter:zip": "pnpm --filter product-filter zip",
    "quality": "pnpm quality:public",
    "quality:all": "pnpm quality:public",
    "quality:public": "pnpm check:public-boundary && pnpm licenses:check:public && pnpm format:check:public && pnpm lint:public && pnpm --filter @browser-extensions/ui --filter watched-filter --filter product-filter --filter quick-notes --filter time-zone-helper --filter site-reset --filter pathswitch --recursive --workspace-concurrency=4 quality",
    "quick-notes:build": "pnpm --filter quick-notes build",
    "quick-notes:clean": "pnpm --filter quick-notes clean",
    "quick-notes:dev": "pnpm --filter quick-notes dev",
    "quick-notes:quality": "pnpm --filter quick-notes quality",
    "quick-notes:release:check": "pnpm --filter quick-notes release:check",
    "quick-notes:test": "pnpm --filter quick-notes test:run",
    "quick-notes:typecheck": "pnpm --filter quick-notes typecheck",
    "quick-notes:zip": "pnpm --filter quick-notes zip",
    "release:check": "pnpm release:check:public",
    "release:check:public": "pnpm quality:public && pnpm watched-filter:release:check && pnpm product-filter:release:check && pnpm quick-notes:release:check && pnpm time-zone-helper:release:check && pnpm site-reset:release:check && pnpm pathswitch:release:check && pnpm licenses:check:release",
    "security:audit": "pnpm audit --audit-level high",
    "security:audit:prod": "pnpm audit --prod --audit-level high",
    "site-reset:build": "pnpm --filter site-reset build",
    "site-reset:clean": "pnpm --filter site-reset clean",
    "site-reset:dev": "pnpm --filter site-reset dev",
    "site-reset:quality": "pnpm --filter site-reset quality",
    "site-reset:release:check": "pnpm --filter site-reset release:check",
    "site-reset:test": "pnpm --filter site-reset test:run",
    "site-reset:typecheck": "pnpm --filter site-reset typecheck",
    "site-reset:zip": "pnpm --filter site-reset zip",
    "test": "pnpm watched-filter:test",
    "test:public-export": "node --test scripts/export-public-workspace.test.mjs",
    "time-zone-helper:build": "pnpm --filter time-zone-helper build",
    "time-zone-helper:clean": "pnpm --filter time-zone-helper clean",
    "time-zone-helper:dev": "pnpm --filter time-zone-helper dev",
    "time-zone-helper:quality": "pnpm --filter time-zone-helper quality",
    "time-zone-helper:release:check": "pnpm --filter time-zone-helper release:check",
    "time-zone-helper:test": "pnpm --filter time-zone-helper test:run",
    "time-zone-helper:typecheck": "pnpm --filter time-zone-helper typecheck",
    "time-zone-helper:zip": "pnpm --filter time-zone-helper zip",
    "ui:quality": "pnpm --filter @browser-extensions/ui quality",
    "ui:test": "pnpm --filter @browser-extensions/ui test:run",
    "ui:typecheck": "pnpm --filter @browser-extensions/ui typecheck",
    "watched-filter:build": "pnpm --filter watched-filter build",
    "watched-filter:build:firefox": "pnpm --filter watched-filter build:firefox",
    "watched-filter:clean": "pnpm --filter watched-filter clean",
    "watched-filter:dev": "pnpm --filter watched-filter dev",
    "watched-filter:dev:firefox": "pnpm --filter watched-filter dev:firefox",
    "watched-filter:quality": "pnpm --filter watched-filter quality",
    "watched-filter:release:check": "pnpm --filter watched-filter release:check",
    "watched-filter:test": "pnpm --filter watched-filter test",
    "watched-filter:test:coverage": "pnpm --filter watched-filter test:coverage",
    "watched-filter:test:run": "pnpm --filter watched-filter test:run",
    "watched-filter:typecheck": "pnpm --filter watched-filter typecheck",
    "watched-filter:zip": "pnpm --filter watched-filter zip",
    "watched-filter:zip:firefox": "pnpm --filter watched-filter zip:firefox"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "24.x",
    "pnpm": "11.x"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tailwindcss/vite": "4.3.2",
    "@types/node": "^24.12.2",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "tailwindcss": "4.3.2",
    "typescript": "6.0.3",
    "vite": "6.4.3",
    "vitest": "^4.1.9",
    "wxt": "0.21.3"
  }
}
